# Copy this file to .env for local `vercel dev` / `npm run dev` use.
# .env is already gitignored — never commit real keys.

# TheirStack Job Search API — https://app.theirstack.com/settings/api-key
# Required for the TheirStack half of the /international-jobs page.
THEIRSTACK_API_KEY=

# Optional tuning — sane credit-conscious defaults are already set in
# api/theirstack.js if you leave these unset.
# THEIRSTACK_JOB_LIMIT=20
# THEIRSTACK_CACHE_SECONDS=86400
