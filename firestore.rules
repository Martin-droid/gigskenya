rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────
    function isAuth()     { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    // Reads the caller's role from their user document (1 extra read on writes).
    // Used to enforce that talent cannot act as hirers and vice versa.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isHirer()  { return isAuth() && callerRole() == 'hirer';  }
    function isTalent() { return isAuth() && callerRole() == 'talent'; }

    function isParticipant() {
      return isAuth() && request.auth.uid in resource.data.participants;
    }

    // ── ADS (listings) ───────────────────────────────────────────
    // Both roles may post (talent lists services, hirers list jobs).
    // Only the owner can edit or delete their own ad.
    match /ads/{adId} {
      allow read:           if true;
      allow create:         if isAuth();
      allow update, delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    // ── USERS ────────────────────────────────────────────────────
    // `role` is immutable — the update rule rejects any attempt to
    // change it, even by the account owner. Prevents talent→hirer
    // self-promotion via direct Firestore writes.
    match /users/{userId} {
      allow get:    if resource.data.role == 'talent' || isAuth();
      allow list:   if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // ── TALENT PROFILES ──────────────────────────────────────────
    // Only a confirmed talent account may write a talent profile.
    // A hirer who tries to create a talent profile is blocked here.
    match /profiles/{uid} {
      allow read:  if true;
      allow write: if isOwner(uid) && isTalent();
    }

    // ── HIRER PROFILES ───────────────────────────────────────────
    // Only a confirmed hirer account may write a hirer profile.
    // A talent who tries to create a hirer profile is blocked here.
    match /hirer_profiles/{uid} {
      allow read:  if isAuth();
      allow write: if isOwner(uid) && isHirer();
    }

    // ── MESSAGES ─────────────────────────────────────────────────
    // get:  sender or receiver may read a single message directly.
    // list: for collection queries (subscribeToMessages), Firebase's rules
    //       engine cannot statically prove the senderId/receiverId check
    //       passes for all documents in the result, so it denies the query.
    //       Instead we verify thread participation via a get() on the parent
    //       thread — this works for both new messages (with participants[])
    //       and existing messages that predate that field.
    match /messages/{messageId} {
      allow get:            if isAuth()
                            && (request.auth.uid == resource.data.senderId
                                || request.auth.uid == resource.data.receiverId);
      allow list:           if isAuth()
                            && resource.data.threadId is string
                            && request.auth.uid in
                               get(/databases/$(database)/documents/threads/$(resource.data.threadId)).data.participants;
      allow create:         if isAuth()
                            && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── THREADS ──────────────────────────────────────────────────
    // get:  any auth user may check if a specific thread exists.
    //       Needed by getOrCreateThread before creating a new thread.
    //       Thread IDs are [uid1,uid2].sort().join('_') so a caller
    //       already needs both UIDs — no privacy concern.
    // list: only participants may query/subscribe to their own threads.
    match /threads/{threadId} {
      allow get:    if isAuth();
      allow list:   if isParticipant();
      allow create: if isAuth()
                    && request.auth.uid in request.resource.data.participants;
      allow update: if isParticipant();
      allow delete: if false;
    }

    // ── RATINGS ──────────────────────────────────────────────────
    // Public read so anyone can see a freelancer's score.
    // A user may only submit or update a rating as themselves.
    match /ratings/{ratingId} {
      allow read:           if true;
      allow create, update: if isAuth()
                            && request.resource.data.raterId == request.auth.uid;
      allow delete:         if false;
    }

    // ── REPORTS ──────────────────────────────────────────────────
    // Anyone can file a report; admin access is via Firebase Console only.
    match /reports/{reportId} {
      allow create:               if true;
      allow read, update, delete: if false;
    }

    // ── PLATFORM STATS ────────────────────────────────────────────
    // Public read (homepage counters). Auth required to write.
    match /platform_stats/{docId} {
      allow read:  if true;
      allow write: if isAuth();
    }

  }
}
